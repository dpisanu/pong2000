{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "game/multi",
    "game/single"
  ],
  "scripts": {
    "dev": "npm --prefix game/multi run dev",
    "dev:single": "npm --prefix game/single run dev",
    "start": "npm --prefix game/multi start",
    "build": "npm --prefix game/multi run build",
    "build:single": "npm --prefix game/single run build",
    "preview": "npm --prefix game/multi run preview",
    "clean": "npm --prefix game/multi run clean",
    "lint": "npm --prefix game/multi run lint",
    "lint:single": "npm --prefix game/single run lint",
    "test": "npm --prefix game/multi test && npm --prefix game/single test",
    "test:single": "npm --prefix game/single test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}

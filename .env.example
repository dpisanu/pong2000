# LAN Pong Arena configuration
PORT=3000
HOST=0.0.0.0

# Directory where sanitized uploaded WebP avatars are stored (persisted via Docker volume)
AVATAR_STORAGE_DIR=./data/avatars

# Optional comma-separated extra allowed origins for WebSocket/upload checks
# ALLOWED_ORIGINS=http://192.168.1.42:3000

# Optional explicit URL shown in the LAN Share dialog if auto-detection is not desired
# PUBLIC_URL=http://192.168.1.42:3000
